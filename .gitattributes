* text=auto
*.sh text eol=lf
*.rs text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cg text eol=lf
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.gxp binary
*.agxp binary
*.pfs binary
# Packaged demo hashes cover exact asset bytes on Windows and Linux.
host-direct/assets/demos/** -text whitespace=cr-at-eol
# Builtin lookup hashes original shader bytes, including line endings.
host-direct/assets/TEST_SHADERS_51/**/*.hlsl binary
host-direct/assets/TEST_SHADERS_EXTERNAL/**/*.hlsl binary
# Preserve certificate and upstream patch bytes across Windows/Linux builds.
host-direct/resources/update-ca.pem text eol=lf
vendor/update-network/mbedtls-vita.patch text eol=lf -whitespace
