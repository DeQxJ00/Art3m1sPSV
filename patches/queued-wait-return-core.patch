+            let mut new_index = 0;
+            self.queued_wait_checkpoints.retain(|checkpoint| {
+                let keep = checkpoint.stack.len() <= depth;
+                if keep {
+                    if old_active == Some(old_index) {
+                        new_active = Some(new_index);
+                    }
+                    new_index += 1;
+                }
+                old_index += 1;
+                keep
+            });
