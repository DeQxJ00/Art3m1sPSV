// Port of core/src/render_pipeline/shader.rs built-ins. This path returns
// exactly the GL shader's RGBA; blend state handles straight/premultiplied RGB.
float4 main(float2 uv : TEXCOORD0, float4 tint : COLOR0, float2 pixel : TEXCOORD1,
    uniform sampler2D image : TEXUNIT0, uniform sampler2D mask : TEXUNIT1,
    uniform float4 flags, uniform float4 transition, uniform float4 clipRect,
    uniform float4 corners[4], uniform float4 uvRect, uniform float4 modelClip,
    uniform float4 wipe, uniform float4 modelX, uniform float4 modelY) : COLOR {
    if (pixel.x < clipRect.x || pixel.y < clipRect.y ||
        pixel.x >= clipRect.z || pixel.y >= clipRect.w) discard;
    float4 c = tex2D(image,uv);
    if (flags.x > 2.5) {
        float sourceAlpha = c.a;
        float3 rgb = sourceAlpha > 0 ? c.rgb/sourceAlpha : float3(0,0,0);
        rgb *= tint.rgb;
        if (flags.y != 0) rgb = dot(rgb,float3(.299,.587,.114));
        if (flags.z != 0) rgb = 1-rgb;
        float a = lerp(sourceAlpha,1,transition.z)*tint.a*tex2D(mask,uv).a;
        return float4(rgb*a,a);
    }
    if (flags.x > 1.5) {
        float a = tint.a*tex2D(mask,uv).a;
        return float4(c.rgb*tint.rgb*a,c.a*a);
    }
    if (flags.x > .5) {
        float vague = max(transition.y,1.0/255.0);
        float threshold = transition.x*(1+vague)-vague;
        c.a *= smoothstep(threshold,threshold+vague,tex2D(mask,uv).r);
        return c*tint;
    }
    if (flags.w != 0) {
        float3 p = float3(pixel,1);
        float2 model = float2(dot(modelX.xyz,p),dot(modelY.xyz,p));
        if (model.x < modelClip.x || model.y < modelClip.y ||
            model.x > modelClip.z || model.y > modelClip.w) discard;
        float2 span = uvRect.zw-uvRect.xy;
        span = float2(abs(span.x)>0.000001?span.x:1,abs(span.y)>0.000001?span.y:1);
        float2 local = clamp((uv-uvRect.xy)/span,0,1);
        c *= lerp(lerp(corners[0],corners[1],local.x),lerp(corners[2],corners[3],local.x),local.y);
        if (wipe.z > .5) c.a = clamp(c.a*wipe.x+wipe.y,0,1);
        // Cg profile has no need for bitwise integer ops: decode on the host.
        if (modelX.w != 0) c.rgb = clamp(c.rgb*2,0,1);
        if (wipe.w == 3 || wipe.w == 4) c.rgb *= c.a;
        else if (wipe.w == 5) c.rgb = 1-c.rgb;
        if (c.a <= .003) discard;
    }
    c.rgb *= tint.rgb;
    if (flags.y != 0) c.rgb = dot(c.rgb,float3(.299,.587,.114));
    if (flags.z != 0) c.rgb = 1-c.rgb;
    c.a *= tint.a;
    return c;
}
