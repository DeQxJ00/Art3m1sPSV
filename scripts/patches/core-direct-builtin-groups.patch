diff --git a/core/src/runtime/fixed_masks.rs b/core/src/runtime/fixed_masks.rs
new file mode 100644
index 0000000..0ad976c
--- /dev/null
+++ b/core/src/runtime/fixed_masks.rs
@@ -0,0 +1,145 @@
+//! Chapter-entry preparation of immutable rule images. No background job or wait.
+//! Keep decoded CPU copies so video can reclaim GPU textures without PNG decoding.
+use std::collections::{BTreeSet,HashMap};
+use crate::image_cache_budget::{CacheParts,SharedCacheBudget};
+use crate::image_proof::TileProof;
+use crate::resource_ledger::{Charge,Owner,Tracked};
+
+const LIMIT:usize=48*1024*1024;
+const MAX_ENTRIES:usize=128;
+type ReadyMask=(Tracked<image::RgbaImage>,Option<TileProof>);
+pub(super) struct Cache {
+    entries:HashMap<String,ReadyMask>,
+    account:SharedCacheBudget,
+    parts:CacheParts,
+    prepared_directory:Option<String>,
+    hits:u64,
+    comments:super::png_comments::SharedComments,
+}
+impl Cache {
+    pub fn new(account:SharedCacheBudget)->Self{
+        Self{entries:HashMap::new(),account,parts:CacheParts::default(),prepared_directory:None,hits:0,comments:Default::default()}
+    }
+    pub fn comments(&self)->super::png_comments::SharedComments{self.comments.clone()}
+    pub fn prepare_chapter(&mut self,script:&str,paths:&super::magic_path::MagicPathTable){
+        // Engine/library Lua imports are not chapter boundaries. AST/ASB boot
+        // scripts may prepare earlier; later chapters reuse the same fixed set.
+        if !is_scenario(script){return;}
+        let Some(directory)=paths.lock().unwrap().get("rule").cloned() else {return;};
+        let directory=directory.replace('\\',"/").trim_end_matches('/').to_string();
+        if self.prepared_directory.as_ref()==Some(&directory){return;}
+        self.entries.clear();self.account.lock().unwrap().release_masks(self.parts);self.parts=CacheParts::default();
+        self.prepared_directory=Some(directory.clone());
+        let paths=manifest(&directory);
+        crate::core_info!("[fixed-mask-cache] chapter={} directory={} manifest={}",script,directory,paths.len());
+        let comments=self.comments.clone();
+        self.prepare(&paths,|path|super::surface_loader::load(path,&||false,&comments));
+    }
+    fn prepare(&mut self,paths:&[String],mut load:impl FnMut(&str)->Option<super::surface_loader::Payload>){
+        let started=std::time::Instant::now();let mut skipped=0;
+        for path in paths.iter().take(MAX_ENTRIES){
+            if self.entries.contains_key(path){continue;}
+            let Some(super::surface_loader::Payload::Pixels(mut image,_source,mut proof))=load(path) else {skipped+=1;continue;};
+            let parts=CacheParts{decoded:image.as_raw().capacity(),proof:proof.as_ref().map_or(0,TileProof::bytes),..Default::default()};
+            if self.parts.total()+parts.total()>LIMIT||!self.account.lock().unwrap().admit_mask(parts){
+                skipped+=1;crate::core_info!("[fixed-mask-cache] declined path={} bytes={} reason=budget",path,parts.total());continue;
+            }
+            image.transfer(Owner::Ready);if let Some(p)=proof.as_mut(){p.transfer(Owner::Ready);}
+            self.parts.add(parts);self.entries.insert(path.clone(),(image,proof));
+        }
+        crate::core_info!("[fixed-mask-cache] prepared manifest={} entries={} skipped={} decoded={} proof={} total={} limit={} elapsed_us={} budget_included=ready chapter_only=1",
+            paths.len(),self.entries.len(),skipped,self.parts.decoded,self.parts.proof,self.parts.total(),LIMIT,started.elapsed().as_micros());
+    }
+    pub fn copy_for_upload(&mut self,path:&str)->Option<ReadyMask>{
+        // Match the ordinary source resolver's PNG-before-raw precedence.
+        let key=if self.entries.contains_key(&format!("{path}.png")){format!("{path}.png")}else{path.to_owned()};
+        let (image,proof)=self.entries.get(&key)?;
+        let start=std::time::Instant::now();
+        let mut charge=Charge::reserve(Owner::Temporary,image.len());
+        let mut bytes=Vec::new();bytes.try_reserve_exact(image.len()).ok()?;
+        charge.commit(bytes.capacity());bytes.extend_from_slice(image.as_raw());
+        let image=Tracked{data:image::RgbaImage::from_raw(image.width(),image.height(),bytes)?,charge};
+        let proof=match proof{Some(p)=>Some(p.try_copy(Owner::Temporary)?),None=>None};
+        self.hits+=1;
+        if self.hits<=16||self.hits%64==0{
+            crate::core_info!("[fixed-mask-cache] hit path={} hits={} copy_us={} read_bytes=0 png_decode=0 entries={} decoded={} proof={}",key,self.hits,start.elapsed().as_micros(),self.entries.len(),self.parts.decoded,self.parts.proof);
+        }
+        Some((image,proof))
+    }
+}
+impl Drop for Cache{fn drop(&mut self){self.account.lock().unwrap().release_masks(self.parts);}}
+fn is_scenario(path:&str)->bool{path.rsplit('.').next().is_some_and(|ext|ext.eq_ignore_ascii_case("ast")||ext.eq_ignore_ascii_case("asb"))}
+fn parse_manifest(text:&str,directory:&str)->Vec<String>{
+    let prefix=format!("{directory}/");
+    let paths=text.lines().map(|p|p.replace('\\',"/")).filter(|p|{
+        p.len()<511&&!p.contains(':')&&!p.starts_with('/')&&!p.split('/').any(|c|c==".."||c.is_empty())
+        &&p.starts_with(&prefix)&&p.to_ascii_lowercase().ends_with(".png")
+    }).collect::<BTreeSet<_>>();
+    if paths.len()>MAX_ENTRIES{crate::core_warn!("[fixed-mask-cache] manifest entries={} cap={} excess uses ordinary loading",paths.len(),MAX_ENTRIES);}
+    paths.into_iter().take(MAX_ENTRIES).collect()
+}
+fn manifest(directory:&str)->Vec<String>{
+    #[cfg(all(target_os="vita",feature="gxm-backend"))]{
+        unsafe extern "C"{fn host_rule_manifest(directory:*const std::ffi::c_char,out:*mut u8,capacity:i32)->i32;}
+        let Ok(directory_c)=std::ffi::CString::new(directory) else {return Vec::new();};
+        let mut out=vec![0u8;64*1024];
+        let size=unsafe{host_rule_manifest(directory_c.as_ptr(),out.as_mut_ptr(),out.len() as i32)};
+        if size<0||size as usize>=out.len(){crate::core_warn!("[fixed-mask-cache] manifest unavailable result={}",size);return Vec::new();}
+        match std::str::from_utf8(&out[..size as usize]){Ok(text)=>parse_manifest(text,directory),Err(_)=>{crate::core_warn!("[fixed-mask-cache] manifest invalid UTF-8");Vec::new()}}
+    }
+    #[cfg(not(all(target_os="vita",feature="gxm-backend")))]{let _=directory;Vec::new()}
+}
+
+#[cfg(test)]mod tests{
+    use super::*;
+    use super::super::surface_loader::Payload;
+    fn payload()->Option<Payload>{Some(Payload::Pixels(image::RgbaImage::from_pixel(2,2,image::Rgba([11,22,33,44])).into(),vec![5;10].into(),None))}
+    #[test]fn fixed_results_survive_repeated_consumption_and_release_only_their_own_account(){
+        let account=crate::image_cache_budget::CacheBudget::new(128);
+        account.lock().unwrap().set_ready(20);
+        {
+            let mut c=Cache::new(account.clone());let paths=vec!["image/rule/a.png".into()];
+            c.prepare(&paths,|_|payload());c.prepare(&paths,|_|panic!("redecoded"));
+            assert_eq!(account.lock().unwrap().ready,36);
+            for _ in 0..3{let (mut p,_)=c.copy_for_upload("image/rule/a").unwrap();assert_eq!(p.as_raw(),&[11,22,33,44].repeat(4));p.put_pixel(0,0,image::Rgba([0;4]));}
+            assert_eq!(account.lock().unwrap().ready,36);
+            account.lock().unwrap().set_ready(30);assert_eq!(account.lock().unwrap().ready,46);
+            assert!(c.copy_for_upload("image/rule/missing").is_none());
+        }
+        assert_eq!(account.lock().unwrap().ready,30);assert_eq!(account.lock().unwrap().mask_parts.total(),0);
+    }
+    #[test]fn masks_cannot_spend_loader_or_idle_allocations(){
+        let account=crate::image_cache_budget::CacheBudget::new(40);
+        {let mut b=account.lock().unwrap();b.set_ready(10);b.set_idle(10);}
+        let mut c=Cache::new(account.clone());
+        c.prepare(&["rule/a.png".into(),"rule/b.png".into()],|_|payload());
+        assert_eq!(c.entries.len(),1);assert_eq!(account.lock().unwrap().ready_limit(),14);
+        assert!(c.copy_for_upload("rule/b.png").is_none());
+    }
+    #[test]fn corrupt_or_encoded_only_results_use_normal_fallback(){
+        let mut c=Cache::new(crate::image_cache_budget::CacheBudget::new(100));
+        c.prepare(&["rule/a.png".into()],|_|Some(Payload::Encoded(vec![1;8].into(),None)));
+        assert!(c.entries.is_empty());assert_eq!(c.parts.total(),0);
+    }
+    #[test]fn manifest_is_bounded_deduplicated_and_rejects_unrelated_paths(){
+        assert_eq!(parse_manifest("image\\rule\\a.png\nimage/rule/a.png\n../rule/b.png\nimage/bg/a.png\n/rule/a.png\nux0:rule/a.png\nrule/b.png","image/rule"),vec!["image/rule/a.png"]);
+        let many=(0..200).map(|i|format!("rule/{i}.png\n")).collect::<String>();assert_eq!(parse_manifest(&many,"rule").len(),MAX_ENTRIES);
+        assert!(is_scenario("script/ch01.ast"));assert!(is_scenario("boot.ASB"));assert!(!is_scenario("system/helper.lua"));
+        assert_eq!(parse_manifest("graphics/transitions/left.PNG\nimage/rule/wipe_13.png","graphics/transitions"),vec!["graphics/transitions/left.PNG"]);
+    }
