+        let decoder=image::ImageReader::new(std::io::Cursor::new(&jpeg)).with_guessed_format().unwrap().into_decoder().unwrap();
+        assert_eq!(rgba(decoder,8192).unwrap(),image::load_from_memory(&jpeg).unwrap().into_rgba8());
+    }
+    #[test]
