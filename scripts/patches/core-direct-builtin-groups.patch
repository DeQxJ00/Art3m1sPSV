+        && !(n.effect.name==ALPHA_MASK_SHADER || n.effect.name==RULE_TRANS_SHADER
+            || (n.effect.name==GROUP_COMPOSITE_SHADER && scalar(&n.effect,"blendMode",0.0)==0.0))) { return false; }
+    if scalar(e,"opaque",0.0)==0.0 { return true; }
