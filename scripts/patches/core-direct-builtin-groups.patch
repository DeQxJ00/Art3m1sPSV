+        for _ in 0..2{
+            let (pixels,copy)=c.copy_for_upload("rule/a.png").unwrap();assert_eq!(&*pixels,&image);
+            let copy=copy.unwrap();assert_eq!(copy.certificate_for_size(960,540),proof.certificate_for_size(960,540));
+            assert!(copy.certificate_for_size(959,540).is_none());
+        }
+        account.lock().unwrap().set_ready_parts(CacheParts::default()); // Loader shutdown leaves fixed masks intact.
+        assert_eq!(account.lock().unwrap().ready,c.parts.total());
+    }
+}
