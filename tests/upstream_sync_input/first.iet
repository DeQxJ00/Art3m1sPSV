end
function enable(e,p)
 e:tag{"lyevent", id="10", type="click", mode="enable"}
 e:tag{"lyprop", id="40", color="ffffff"}
 e:tag{"debugprint", data="SYNC-INPUT enabled"}
end
function reset(e,p)
 e:tag{"lyevent", id="10", type="click", mode="reset"}
 e:tag{"lyprop", id="40", color="ffffff"}
 e:tag{"debugprint", data="SYNC-INPUT reset"}
end
