*top
[debug mode=1 level=3]
[lua]
function save_slot(e,p)
 e:enqueueTag{"call", file="menu.iet", label="main"}
end
function load_slot(e,p)
 e:enqueueTag{"load", file="sync.dat"}
 e:enqueueTag{"lyprop", id="0", color="ff0000"}
 e:enqueueTag{"debugprint", data="SYNC-LOAD ERROR stale load tail"}
end
function after_load(e,p)
 e:tag{"lyprop", id="0", color="ff0000"}
 e:enqueueTag{"call", file="helper.iet", label="main"}
end
function capture_page(e,p)
 e:enqueueTag{"takess"}
 e:enqueueTag{"savess", file="capture.png", width="960", height="544"}
end
function queue_wait(e,p) e:enqueueTag{"@"} end
function fixture_keys(e,p)
 if e:isDownEdge(37) then save_slot(e,p) end
 if e:isDownEdge(39) then load_slot(e,p) end
 if e:isDownEdge(38) then capture_page(e,p) end
end
__engine:setEventHandler{onLoad="after_load", onEnterFrame="fixture_keys"}
[/lua]
