[lyc id=0 width=960 height=544 color=203040]
[lua]
function getGameMode() return "adv" end
bench={models={},start=0,next=0,phase=0}
local files={"sample01-kaz_10.psb","sample01-ior_9.psb","sample01-kog_12.psb"}
for i,file in ipairs(files) do
 local em=__engine:createEmoteLayer{id="10."..i,files={file},width=960,height=544}
 em:setMeshDivisionRatio(1)
 em:setScale(0.36,0,0)
 em:setCoord((i-2)*285,200,0,0)
 em:playTimeline("普通Ａ",1)
 bench.models[i]=em
end
function bench_frame(e,p)
 local now=e:now()
 if bench.start==0 then bench.start=now;bench.next=now+2000 end
 for i,em in ipairs(bench.models) do
  em:setVariable("face_talk",(math.sin((now-bench.start)/130+i)+1)*2.5,0,0)
 end
 if now>=bench.next then
  bench.next=now+3000
  for _,em in ipairs(bench.models) do em:playTimeline("はい",1) end
 end
 if e:isDownEdge(27) then e:exit() end
end

