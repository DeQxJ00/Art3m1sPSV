*top
[lua]
function getGameMode() return "adv" end
ids={name="panel.speaker",adv="panel.paragraph",sub="panel.translation"}
function mw_getmsgid(role) return ids[role] end
function swap_roles(e) ids={name="panel.paragraph",adv="panel.speaker"} end
function clear_roles(e) ids={} end
function legacy(e) mw_getmsgid=nil end
[/lua]
[lyc id="0" color="0x182334" width="960" height="540"]
