*top
[lyc id="0" color="0x2060c0" width="640" height="360"]
[fontdefault face="font.otf" size="28" color="ffffff" show="none"]
[chgmsg id="text" stack="0"]
[fontinit]
[font left="40" top="30" width="560" height="310"]
[lyc id="1.child" color="0xff8000" width="100" height="100"]
[lyprop id="1.child" left="40" top="40" alpha="128"]
[lyprop id="1" grayscale="1" intermediate_render="0"]
[flip]
[wait time="200"]
[takess]
[savess file="screen.png" width="640" height="360"]
[lysave id="1.child" file="child"]
[lysave id="1" file="group"]
[exit]
