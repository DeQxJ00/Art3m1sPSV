*top
[lyc id="0" color="0x2060c0" width="640" height="360"]
[fontdefault face="font.otf" size="28" color="ffffff" show="none"]
[chgmsg id="text" stack="0"]
[fontinit]
[font left="40" top="30" width="560" height="310"]
[lua]
function mark(e,p)
 if p.stage=="start" then start_time=e:now()
 else local f=assert(io.open("result.txt","a"));f:write(p.name," time=",e:now()-start_time,"\n");f:close();e:debug(p.name..": "..tostring(e:now()-start_time));e:tag{"print",data=p.name..": "..tostring(e:now()-start_time).." ms"};e:tag{"rt"} end
end
[/lua]
[var name="s.automodewait" data="100"]
[automode allow="1" stopbyclick="0" stopbystop="0" syncse=""]
[exec command="automode" mode="1"]
[voice id="probe" file="tone.wav"]
[calllua function="mark" stage="start"]
[@]
[calllua function="mark" stage="end" name="Voice empty"]
[sestop id="probe"]
[automode allow="1" stopbyclick="0" stopbystop="0" syncse="probe"]
[exec command="automode" mode="1"]
[voice id="probe" file="tone.wav"]
[calllua function="mark" stage="start"]
[@]
[calllua function="mark" stage="end" name="Voice selected"]
[sestop id="probe"]
[automode allow="1" stopbyclick="0" stopbystop="0" syncse="other"]
[exec command="automode" mode="1"]
[voice id="probe" file="tone.wav"]
[calllua function="mark" stage="start"]
[@]
[calllua function="mark" stage="end" name="Voice other"]
[sestop id="probe"]
[wait time="0"]
[print data="DONE"]
[exec command="automode" mode="0"]
[flip]
[wait time="200"]
[takess]
[savess file="complete.png" width="640" height="360"]
[exit]
