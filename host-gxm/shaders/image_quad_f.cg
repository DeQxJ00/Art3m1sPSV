// art3m1s explicit-UV image shader. Same vertex interface and scissor behavior
// as NanoVG's image fill; straight RGBA becomes premultiplied before blending.
uniform float4 frag[11];
#define scissorMat float3x3(frag[0].xyz, frag[1].xyz, frag[2].xyz)
#define innerCol frag[6]
#define scissorExt frag[8].xy
#define scissorScale frag[8].zw

float4 main(
    uniform sampler2D image : TEXUNIT0,
    float2 ftcoord : TEXCOORD0,
    float2 fpos : TEXCOORD1
) : COLOR {
    float4 color = tex2D(image, ftcoord);
    color.rgb *= color.a;
    float2 sc = abs(mul(scissorMat, float3(fpos, 1.0)).xy) - scissorExt;
    sc = saturate(float2(0.5, 0.5) - sc * scissorScale);
    return color * innerCol * sc.x * sc.y;
}
