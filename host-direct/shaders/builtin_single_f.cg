// Single sprite + group, with the original RGBA8 intermediate quantization.
float4 main(float2 uv:TEXCOORD0,float4 tint:COLOR0,float2 pixel:TEXCOORD1,
    uniform sampler2D image:TEXUNIT0,uniform float4 flags,uniform float4 transition,
    uniform float4 clipRect,uniform float4 cornerTL):COLOR {
    float4 c=tex2D(image,uv);
    float coverage=step(clipRect.x,pixel.x)*step(clipRect.y,pixel.y)*
        (1-step(clipRect.z,pixel.x))*(1-step(clipRect.w,pixel.y));
    float factor=tint.a*coverage;
    float sourceAlpha=c.a*cornerTL.a;
    float3 storedRGB=floor(saturate(c.rgb*cornerTL.rgb*sourceAlpha)*255+.5)/255;
    sourceAlpha=floor(saturate(sourceAlpha)*255+.5)/255;
    float3 rgb=sourceAlpha>0 ? storedRGB/sourceAlpha*tint.rgb : float3(0,0,0);
    if(flags.y!=0)rgb=dot(rgb,float3(.299,.587,.114));
    if(flags.z!=0)rgb=1-rgb;
    float a=lerp(sourceAlpha,1,transition.z)*factor;
    return float4(rgb*a,a);
}
