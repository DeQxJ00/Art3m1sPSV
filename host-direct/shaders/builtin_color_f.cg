// Ordinary filtered sprite/rule; deliberately excludes E-mote and FBO logic.
float4 main(float2 uv:TEXCOORD0,float4 tint:COLOR0,float2 pixel:TEXCOORD1,
    uniform sampler2D image:TEXUNIT0,uniform sampler2D mask:TEXUNIT1,
    uniform float4 flags,uniform float4 transition,uniform float4 clipRect):COLOR {
    float4 c=tex2D(image,uv);c.rgb*=tint.rgb;
    if(flags.y!=0)c.rgb=dot(c.rgb,float3(.299,.587,.114));
    if(flags.z!=0)c.rgb=1-c.rgb;
    c.a*=tint.a;
    if(flags.x==1){
        float v=max(transition.y,.0039215686),t=transition.x*(1+v)-v;
        c.a*=smoothstep(t,t+v,tex2D(mask,uv).r);
    }
    float coverage=step(clipRect.x,pixel.x)*step(clipRect.y,pixel.y)*
        (1-step(clipRect.z,pixel.x))*(1-step(clipRect.w,pixel.y));
    return c*coverage;
}
