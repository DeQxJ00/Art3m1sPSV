// Planar BT.601 YUV444. Colour and mask ranges travel independently per frame.
// Point samples at texel centres: preserve the CPU path's per-pixel clamp
// before the existing sprite renderer later filters/scales the RGBA result.
float4 main(float2 uv:TEXCOORD0, float4 ranges:COLOR0,
    uniform sampler2D planeY:TEXUNIT0, uniform sampler2D planeU:TEXUNIT1,
    uniform sampler2D planeV:TEXUNIT2, uniform sampler2D planeA:TEXUNIT3):COLOR {
    float full=ranges.r, maskFull=ranges.g;
    float y=tex2D(planeY,uv).r*255.0-16.0*(1.0-full);
    float u=tex2D(planeU,uv).r*255.0-128.0;
    float v=tex2D(planeV,uv).r*255.0-128.0;
    float a=tex2D(planeA,uv).r*255.0-16.0*(1.0-maskFull);
    float l=y*lerp(76309.0,65536.0,full)+32768.0;
    float3 rgb=floor(float3(l+lerp(104597.0,91881.0,full)*v,l-lerp(25675.0,22554.0,full)*u-lerp(53279.0,46802.0,full)*v,l+lerp(132201.0,116130.0,full)*u)/65536.0);
    float alpha=floor((a*lerp(76309.0,65536.0,maskFull)+32768.0)/65536.0);
    return saturate(float4(rgb,alpha)/255.0);
}
