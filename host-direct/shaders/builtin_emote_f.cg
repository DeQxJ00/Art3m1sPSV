// Native E-mote with uniform corner color, no model clip or wipe.
// The host keeps gradients, bounded model clips and image effects on builtin_f.
float4 main(float2 uv:TEXCOORD0, float4 tint:COLOR0, float2 pixel:TEXCOORD1,
    uniform sampler2D image:TEXUNIT0, uniform float4 clipRect,
    uniform float4 cornerTL, uniform float4 wipe, uniform float4 modelX):COLOR {
    if(pixel.x<clipRect.x || pixel.y<clipRect.y || pixel.x>=clipRect.z || pixel.y>=clipRect.w) discard;
    float4 c=tex2D(image,uv)*cornerTL;
    if(modelX.w>0.5)c.rgb=saturate(c.rgb*2);
    if(wipe.w==3 || wipe.w==4)c.rgb*=c.a;
    else if(wipe.w==5)c.rgb=1-c.rgb;
    if(c.a<=0.003)discard;
    c.rgb*=tint.rgb;
    c.a*=tint.a;
    return c;
}
