float4 main(float2 uv : TEXCOORD0, float4 tint : COLOR0, float2 pixel : TEXCOORD1,
            uniform sampler2D image : TEXUNIT0, uniform float4 clipRect) : COLOR {
    float4 c = tex2D(image, uv) * tint;
    c.a *= step(clipRect.x,pixel.x)*step(clipRect.y,pixel.y)*
           (1-step(clipRect.z,pixel.x))*(1-step(clipRect.w,pixel.y));
    return float4(c.rgb * c.a, c.a);
}
